+        InventoryLock.batch_id.is_(None),
+    )
+    if (await db_session.execute(stmt_full)).first():
+        raise ValueError(f"الموقع ({location_id}) تحت الجرد الشامل ومقفل بالكامل.")
+
+    if variant_id is None:
+        return
+
+    partial_filters = [
