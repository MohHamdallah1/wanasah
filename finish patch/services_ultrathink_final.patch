+    if batch_id is None:
+        # طلب عام على الصنف: قفل دفعة واحدة لا يجب أن يتحول إلى قفل للصنف كله.
+        partial_filters.append(InventoryLock.batch_id.is_(None))
+    else:
+        # طلب على دفعة محددة: يحترم قفل الدفعة نفسها أو قفل الصنف العام.
+        partial_filters.append(
+            or_(
+                InventoryLock.batch_id == batch_id,
+                InventoryLock.batch_id.is_(None),
