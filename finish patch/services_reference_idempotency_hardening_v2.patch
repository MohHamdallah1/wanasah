@@ -423,5 +423,41 @@
 
 
 
+    def test_31_reference_type_is_canonical_and_stocktake_refs_are_case_safe(self):
+        self.stock()
+        movement = self.move(
+            reference_type="visit_sale",
+            idempotency_key="sale-lowercase-ref",
+        )
+        self.assertEqual(movement.reference_type, "VISIT_SALE")
+
+        with self.assertRaises(services.InventoryMutationError):
+            self.move(
+                reference_type="audit_adjustment",
+                idempotency_key="audit-lowercase-ref",
+            )
+
+    def test_32_reversal_retry_rejects_different_actor(self):
+        balance = self.stock()
+        original = self.move()
+        self.orm.flush()
+        values = dict(
+            original=original,
+            reference_type="VISIT_REVERSAL",
+            reference_id="1",
+        )
+        asyncio.run(services.reverse_inventory_movement(
+            self.db, performed_by=1, **values
+        ))
+        self.orm.flush()
+        self.assertEqual(balance.on_hand_quantity, 10)
+
+        with self.assertRaises(services.InventoryMutationError):
+            asyncio.run(services.reverse_inventory_movement(
+                self.db, performed_by=2, **values
+            ))
+        self.assertEqual(balance.on_hand_quantity, 10)
+
+
 if __name__ == "__main__":
